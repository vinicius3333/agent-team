[
  {
    "id": "K-sec-session-cookie-flags",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Set session cookies with HttpOnly, SameSite=Lax or Strict, and Secure on https, so scripts and cross-site requests cannot use them.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Session_Management_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-session-rotation",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Issue a new session id on login and privilege change, and delete the session on the server at logout, to stop session fixation.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Session_Management_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-password-hashing",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Hash passwords with Argon2id, or bcrypt when Argon2id is not available; never store them reversibly or with a fast hash such as SHA-256.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Password_Storage_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-generic-auth-errors",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Return the same error for an unknown user and a wrong password, so attackers cannot find out which accounts exist.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Authentication_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-rate-limit-auth",
    "roles": [
      "architect",
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Rate-limit login, signup, password reset, and code-verification endpoints per account and per IP, to block brute force.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Authentication_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-server-authorization",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Check authorization on the server for every request that reads or changes a resource; hiding a button is not access control.",
    "source": "https://owasp.org/Top10/A01_2021-Broken_Access_Control/",
    "sourceTitle": "OWASP Top 10 2021",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-server-validation",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Validate every input on the server against a schema (type, length, format); client-side validation is only for the user's convenience.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Input_Validation_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-parameterized-sql",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Use parameterized queries or the ORM's bound parameters; never build SQL by joining strings.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/SQL_Injection_Prevention_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-csrf",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Protect state-changing requests that use cookie auth against CSRF with SameSite cookies plus a token or an Origin check, and never change state on GET.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Cross-Site_Request_Forgery_Prevention_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-secrets",
    "roles": [
      "architect",
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Keep secrets out of the repo and the client bundle: read them from environment variables and commit only a .env.example.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Management_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-log-redaction",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Never log passwords, tokens, card data, or personal documents; redact them before logging.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Logging_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-sec-xss",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Let the framework escape output, and never put user data into innerHTML or dangerouslySetInnerHTML, to prevent XSS.",
    "source": "https://cheatsheetseries.owasp.org/cheatsheets/Cross_Site_Scripting_Prevention_Cheat_Sheet.html",
    "sourceTitle": "OWASP Cheat Sheets",
    "license": "CC BY-SA 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-a11y-contrast",
