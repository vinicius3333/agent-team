  {
    "id": "K-perf-core-web-vitals",
    "roles": [
      "architect",
      "qa",
      "evaluator"
    ],
    "stacks": [],
    "rule": "Aim for LCP under 2.5 s, INP under 200 ms, and CLS under 0.1 at the 75th percentile of page loads.",
    "source": "https://web.dev/articles/vitals",
    "sourceTitle": "web.dev",
    "license": "CC BY 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-perf-no-layout-shift",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Set width and height, or an aspect-ratio, on images and embeds so the layout does not jump while they load.",
    "source": "https://web.dev/articles/optimize-cls",
    "sourceTitle": "web.dev",
    "license": "CC BY 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-perf-lcp-image",
    "roles": [
      "worker"
    ],
    "stacks": [],
    "rule": "Never lazy-load the largest image above the fold; load it eagerly with high priority, and lazy-load images below the fold.",
    "source": "https://web.dev/articles/optimize-lcp",
    "sourceTitle": "web.dev",
    "license": "CC BY 4.0",
    "checkedAt": "2026-09-25"
  },
  {
    "id": "K-perf-short-tasks",
    "roles": [
      "worker",
      "reviewer"
    ],
    "stacks": [],
    "rule": "Keep main-thread work short: split or defer heavy JavaScript so the page answers input quickly.",
    "source": "https://web.dev/articles/optimize-inp",
    "sourceTitle": "web.dev",
    "license": "CC BY 4.0",
    "checkedAt": "2026-09-25"
  },
  {
